      "Bash(do if git cat-file -p \"$blob\")",
      "Bash(then echo \"FOUND: $blob\")",
      "Bash(xargs -I{} sh -c 'git cat-file -s {} 2>/dev/null | xargs -I@ echo \"\"{}:@\"\"')",
      "Bash(while read tree)",
      "Bash(do if git ls-tree \"$tree\")",
      "Bash(then echo \"FOUND TREE: $tree\")",
      "Bash(fi)",
      "Bash(done)",
      "Bash(git log:*)",
      "Bash(python3:*)",
      "Bash(file:*)",
